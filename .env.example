GEMINI_API_KEY=
OPENAI_API_KEY=

# Alibaba DashScope (Model Studio), API tương thích OpenAI
DASHSCOPE_API_KEY=
# Quốc tế (Singapore); key vùng Bắc Kinh dùng https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenRouter (API tương thích OpenAI), dùng sinh đáp án nháp cho dataset
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sinh đáp án nháp (src/data_prep/draft_answers.py): dashscope hoặc openrouter
DRAFT_PROVIDER=dashscope
DRAFT_VLM_MODEL=qwen3-vl-plus
CHECK_MODEL=qwen3.7-flash
# 1 = model kiểm tra chỉ đọc text trang (qwen3.7-flash không đọc được ảnh)
CHECK_TEXT_ONLY=1
