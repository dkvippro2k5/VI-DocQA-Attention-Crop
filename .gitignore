data/processed/*
!data/processed/.gitkeep
*.pdf
*.png
*.jpg
*.jpeg

# Results / large outputs
results/**/*.json
results/**/*.csv
!results/**/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
