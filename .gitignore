# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Env / secrets
.env
*.key

# Data (large/raw files typically not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/diagnostic/en/*
!data/diagnostic/en/.gitkeep
data/diagnostic/vi/*
!data/diagnostic/vi/.gitkeep
*.pdf
*.png
*.jpg
*.jpeg
*.zip

# Results / large outputs
results/**/*.json
results/**/*.csv
!results/**/*_config.json
!results/**/.gitkeep
# LLM-judge: κ và quyết định chọn judge (nhỏ, cần để tái lập chỉ số chính)
!results/judge/*.json

# Claude Code local state
.claude/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Ảnh chẩn đoán: font tải về, văn bản đệm
data/diagnostic/fonts/
data/diagnostic/corpus_*.jsonl
# Ma trận attention/peak (lớn)
results/**/*.npz
