# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Env / secrets
.env
*.key

# Data (large/raw files typically not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/diagnostic/en/*
!data/diagnostic/en/.gitkeep
data/diagnostic/vi/*
!data/diagnostic/vi/.gitkeep
*.pdf
*.png
*.jpg
*.jpeg
*.zip

# Results / large outputs
results/**/*.json
results/**/*.csv
!results/**/*_config.json
!results/**/.gitkeep

# Claude Code local state
.claude/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
